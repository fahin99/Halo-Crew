 display=box('VisualStation_TestDisplay',g,(sx-135,sy-10.5,sz+120),(270,1,170),'black','Display visual targets for acuity, contrast, Amsler and exploratory field tests','Requires photometric/geometric calibration; not a validated clinical perimeter');highlights.append(display)
