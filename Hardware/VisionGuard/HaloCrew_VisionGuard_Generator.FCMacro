# Error-reporting wrapper for all modeling and export operations.
import os, traceback
try:
 # HaloCrew VisionGuard — FreeCAD native engineering concept, mm
 # Execute in FreeCAD GUI. Geometry is not a medical device validation.
 import FreeCAD as App, Part, Sketcher, math, os, json, csv, traceback
 from FreeCAD import Vector as V
 try:
  import FreeCADGui as Gui
 except ImportError: Gui=None
 OUT=os.environ.get('VISIONGUARD_OUTPUT',os.path.dirname(globals().get('__file__','')) or os.path.expanduser('~/VisionGuard'))
 os.makedirs(OUT,exist_ok=True)
 DOC='HaloCrew_VisionGuard_Complete'
 if DOC in App.listDocuments(): App.closeDocument(DOC)
 doc=App.newDocument(DOC)
 C={'black':(0.10,0.12,0.15),'white':(.85,.89,.92),'metal':(.52,.59,.65),'dark':(.20,.25,.30),'pcb':(.04,.34,.29),'gold':(.85,.63,.22),'cyan':(.05,.78,.90),'glass':(.62,.88,.96),'silicone':(.17,.19,.21)}
 parts=[]; covers=[]; groups={}; highlights=[]; errors=[]
 def group(name,parent=None):
  g=doc.addObject('App::DocumentObjectGroup',name); g.Label=name.replace('_',' ')
  if parent: parent.addObject(g)
  groups[name]=g; return g
 root=group('VisionGuard_System')
 p=doc.addObject('App::FeaturePython','Design_Parameters'); root.addObject(p)
 for name,val in [('GlassesWidth',145),('LensOpening',53),('LensHeight',37),('Bridge',19),('TempleLength',145),('FrameThickness',4),('HousingWall',2.5),('OCTWidth',150),('OCTDepth',190),('OCTHeight',95),('FundusWidth',100),('FundusDepth',155),('FundusHeight',85),('DisplayWidth',270),('DisplayHeight',170),('TestDistance',500),('DockRailWidth',36),('FitClearance',.4)]:
  p.addProperty('App::PropertyLength',name,'Dimensions'); setattr(p,name,val)
 p.addProperty('App::PropertyString','DesignStatus','Clinical'); p.DesignStatus='Unvalidated geometric concept; no performance or eye-safety claim'
 A=group('Wearable_Glasses',root)
 for n in ['Structural_Frame','Optical_Lenses','Eye_Tracking_Assembly','IR_Illumination_Assembly','IMU_Assembly','Visual_Test_Display','Environmental_Sensors','Electronics','Battery_And_Power','Hinges_And_Temples']:group(n,A)
 B=group('Diagnostic_Optical_Modules',root)
 for n in ['OCT_Concept_Assembly','Fundus_Camera_Assembly','Refractive_Test_Assembly','Docking_Connectors']:group(n,B)
 CC=group('Clinical_Instruments',root)
 for n in ['Ocular_Ultrasound','Tonometer','Vision_Test_Station']:group(n,CC)
 aux=group('Presentation_Optical_Paths',root)
 def register(o,g,color='white',fn='',purpose='',kind='',cover=False):
  o.Label=o.Name.replace('_',' '); groups[g].addObject(o)
  for prop,value in [('Function',fn or o.Label),('ClinicalPurpose',purpose or 'Mechanical integration / concept packaging'),('HardwareClass',kind or ('Wearable' if g in [x.Name for x in A.Group] else 'Detachable' if g in [x.Name for x in B.Group] else 'Separate examination instrument')),('ValidationStatus','Concept geometry; not clinically validated')]:
   o.addProperty('App::PropertyString',prop,'Identification'); setattr(o,prop,value)
  o.addProperty('App::PropertyVector','AssembledPosition','Configurations'); o.AssembledPosition=o.Placement.Base
  o.addProperty('App::PropertyVector','ExplodeOffset','Configurations'); o.ExplodeOffset=V(0,0,45 if cover else 15+(len(parts)%4)*12)
  if Gui:
   o.ViewObject.ShapeColor=C[color]; o.ViewObject.LineColor=(.16,.21,.25)
   if color=='glass': o.ViewObject.Transparency=72
  parts.append(o)
  if cover:covers.append(o)
  return o
 
 def box(n,g,pos,size,color='white',fn='',purpose='',cover=False):
  o=doc.addObject('Part::Box',n); o.Length,o.Width,o.Height=size; o.Placement.Base=V(*pos)
  return register(o,g,color,fn,purpose,cover=cover)
 def cyl(n,g,pos,r,h,color='metal',axis=(0,0,1),fn='',purpose=''):
  o=doc.addObject('Part::Cylinder',n); o.Radius=r; o.Height=h;o.Placement=App.Placement(V(*pos),App.Rotation(V(0,0,1),V(*axis)))
  return register(o,g,color,fn,purpose)
 def solid(n,g,shape,color='white',fn='',purpose='',cover=False):
  o=doc.addObject('Part::Feature',n);o.Shape=shape
  return register(o,g,color,fn,purpose,cover=cover)
 def ring(n,g,pos,ro,ri,h,color='metal',axis=(0,0,1),fn=''):
  s=Part.makeCylinder(ro,h,V(*pos),V(*axis)).cut(Part.makeCylinder(ri,h+.2,V(*pos)-V(*axis)*.1,V(*axis)))
  return solid(n,g,s,color,fn)
 def rod(n,g,a,b,r=1,color='metal',fn=''):
  v=V(*b)-V(*a);return cyl(n,g,a,r,v.Length,color,tuple(v),fn)
 def cable(n,g,points,r=1,color='black'):
  # Swept-looking segmented routing; individual rounded bend junctions
  shapes=[]
  for a,b in zip(points[:-1],points[1:]):
   d=V(*b)-V(*a);shapes.append(Part.makeCylinder(r,d.Length,V(*a),d))
  for pt in points[1:-1]:shapes.append(Part.makeSphere(r,V(*pt)))
  return solid(n,g,Part.makeCompound(shapes),color,'Routed flexible harness; bend geometry is a packaging illustration')
 def screw(n,g,pos,size=1.5):
  s=Part.makeCylinder(size,5,V(*pos)).fuse(Part.makeCylinder(size*1.7,1.4,V(*pos)+V(0,0,5)))
  slot=Part.makeBox(size*2.6,.6,.8,V(*pos)+V(-size*1.3,-.3,5.8))
  return solid(n,g,s.cut(slot),'metal','Captive service fastener')
 def pcb(n,g,pos,size,chipcount=4):
  o=box(n,g,pos,size,'pcb','Printed circuit board with modeled ICs and connector pads')
  x,y,z=pos;w,d,h=size
  for i in range(chipcount):
   cx=x+3+(i%3)*(w-8)/3;cy=y+3+(i//3)*8
   box(n+'_IC_'+str(i+1),g,(cx,cy,z+h+.15),(min(5,w/5),min(5,d/4),1.2),'black')
  for i in range(6):box(n+'_Pad_'+str(i+1),g,(x+1+i*1.5,y+d-2,z+h),(.8,1.4,.1),'gold')
  return o
 
 def rectsk(body,n,w,d,pos):
  s=doc.addObject('Sketcher::SketchObject',n);body.addObject(s);s.Placement.Base=V(*pos)
  pts=[(0,0),(w,0),(w,d),(0,d)]
  for i in range(4):
   a,b=pts[i],pts[(i+1)%4];s.addGeometry(Part.LineSegment(V(*a,0),V(*b,0)),False)
  for i in range(4):s.addConstraint(Sketcher.Constraint('Coincident',i,2,(i+1)%4,1))
  for i in [0,2]:s.addConstraint(Sketcher.Constraint('Horizontal',i))
  for i in [1,3]:s.addConstraint(Sketcher.Constraint('Vertical',i))
  s.addConstraint(Sketcher.Constraint('Coincident',0,1,-1,1))
  s.addConstraint(Sketcher.Constraint('Distance',0,w));s.renameConstraint(9,'Width')
  s.addConstraint(Sketcher.Constraint('Distance',1,d));s.renameConstraint(10,'Depth')
  return s
 
 def housing(n,g,pos,size,wall=2.5,frontport=None):
  # Native sketch + pad + pocket; editable cavity and wall dimensions.
  x,y,z=pos;w,d,h=size
  body=doc.addObject('PartDesign::Body',n);groups[g].addObject(body)
  body.addProperty('App::PropertyLength','EnvelopeWidth','Dimensions');body.EnvelopeWidth=w
  body.addProperty('App::PropertyLength','EnvelopeDepth','Dimensions');body.EnvelopeDepth=d
  body.addProperty('App::PropertyLength','EnvelopeHeight','Dimensions');body.EnvelopeHeight=h
  body.addProperty('App::PropertyLength','Wall','Dimensions');body.Wall=wall
  body.Placement.Base=V(x,y,z)
  for suffix,value in [('EnvelopeWidth',w),('EnvelopeDepth',d),('EnvelopeHeight',h),('Wall',wall)]:
   p.addProperty('App::PropertyLength',n+suffix,'Housing dimensions');setattr(p,n+suffix,value)
  sk=rectsk(body,n+'_OuterSketch',w,d,(0,0,0));sk.setExpression('Constraints.Width','Design_Parameters.'+n+'EnvelopeWidth');sk.setExpression('Constraints.Depth','Design_Parameters.'+n+'EnvelopeDepth')
  pad=body.newObject('PartDesign::Pad',n+'_Pad');pad.Profile=sk;pad.Length=h;pad.setExpression('Length','Design_Parameters.'+n+'EnvelopeHeight');doc.recompute();sk.Visibility=False
  inn=rectsk(body,n+'_CavitySketch',w-2*wall,d-2*wall,(wall,wall,h));inn.setExpression('Constraints.Width','Design_Parameters.'+n+'EnvelopeWidth - 2 * Design_Parameters.'+n+'Wall');inn.setExpression('Constraints.Depth','Design_Parameters.'+n+'EnvelopeDepth - 2 * Design_Parameters.'+n+'Wall');inn.setExpression('Placement.Base.z','Design_Parameters.'+n+'EnvelopeHeight')
  pocket=body.newObject('PartDesign::Pocket',n+'_Pocket');pocket.Profile=inn;pocket.Length=h-wall;pocket.setExpression('Length','Design_Parameters.'+n+'EnvelopeHeight - Design_Parameters.'+n+'Wall');doc.recompute();sk.Visibility=False;pad.Visibility=False;inn.Visibility=False
  if frontport:
   cx,cz,rr=frontport
   port=body.newObject('Sketcher::SketchObject',n+'_ObjectivePortSketch');port.Placement=App.Placement(V(cx,0,cz),App.Rotation(V(1,0,0),90));port.addGeometry(Part.Circle(V(0,0,0),V(0,0,1),rr),False)
   cut=body.newObject('PartDesign::Pocket',n+'_ObjectivePort');cut.Profile=port;cut.Length=wall+.5;doc.recompute();pocket.Visibility=False;port.Visibility=False
  vents=body.newObject('Sketcher::SketchObject',n+'_VentSketch');vents.Placement=App.Placement(V(w,0,0),App.Rotation(V(0,1,0),90))
  for i in range(7):vents.addGeometry(Part.Circle(V(-h*.45,d*.22+i*d*.08,0),V(0,0,1),min(1.7,h*.10)),False)
  ventcut=body.newObject('PartDesign::Pocket',n+'_VentPocket');ventcut.Profile=vents;ventcut.Length=wall+.5;doc.recompute();vents.Visibility=False
  for f in body.Group:
   if f!=body.Tip:f.Visibility=False
  register(body,g,'white','Serviceable housing with editable pad/pocket, port and ventilation history')
  cover=box(n+'_RemovableCover',g,(x,y,z+h+.3),(w,d,wall),'white',cover=True)
  for i,(dx,dy) in enumerate([(5,5),(w-5,5),(5,d-5),(w-5,d-5)]):
   ring(n+'_Boss_'+str(i),g,(x+dx,y+dy,z+wall),3.5,1.7,6)
   screw(n+'_CoverScrew_'+str(i),g,(x+dx,y+dy,z+h-4))
  return body,cover
 
 # A: front frame at (-245,-190,80); rearward temples along +Y.
 X,Y,Z=-245,-190,80
 for side,s in [('Left',-1),('Right',1)]:
  cx=X+s*36;g='Structural_Frame'
  # Closed octagonal ring sketches preserve native edit history.
  body=doc.addObject('PartDesign::Body',side+'_LensRim');groups[g].addObject(body)
  sk=doc.addObject('Sketcher::SketchObject',side+'_RimSketch');body.addObject(sk)
  sk.Placement=App.Placement(V(cx,Y,Z),App.Rotation(V(1,0,0),90))
  for w,h,rev in [(61,45,False),(53,37,True)]:
   q=[(-w/2+5,-h/2),(w/2-5,-h/2),(w/2,-h/2+5),(w/2,h/2-5),(w/2-5,h/2),(-w/2+5,h/2),(-w/2,h/2-5),(-w/2,-h/2+5)]
   if rev:q=q[::-1]
   start=sk.GeometryCount
   for i in range(8):
    a,b=q[i],q[(i+1)%8];sk.addGeometry(Part.LineSegment(V(a[0],a[1],0),V(b[0],b[1],0)),False)
   for i in range(8):sk.addConstraint(Sketcher.Constraint('Coincident',start+i,2,start+(i+1)%8,1))
   for i,(a,b) in enumerate(q):
    for axis,value,dimension,span in [('DistanceX',a,'LensOpening',w),('DistanceY',b,'LensHeight',h)]:
     k=sk.addConstraint(Sketcher.Constraint(axis,start+i,1,value))
     extra=8 if not rev else 0
     inset=5 if abs(value)<span/2-.1 else 0
     expr=('' if value>0 else '-')+'((Design_Parameters.'+dimension+' + '+str(extra)+' mm) / 2 - '+str(inset)+' mm)'
     sk.setExpression('Constraints['+str(k)+']',expr)
  pad=body.newObject('PartDesign::Pad',side+'_RimPad');pad.Profile=sk;pad.Length=4;pad.setExpression('Length','Design_Parameters.FrameThickness');doc.recompute();sk.Visibility=False
  register(body,g,'black','Primary optical rim; editable sketch and pad')
  # Clear lens plate follows chamfered opening.
  q=[(-21.5,-18.3),(21.5,-18.3),(26.3,-13.5),(26.3,13.5),(21.5,18.3),(-21.5,18.3),(-26.3,13.5),(-26.3,-13.5)]
  pts=[V(cx+a,Y-1.4,Z+b) for a,b in q];pts.append(pts[0]);lens=Part.Face(Part.makePolygon(pts)).extrude(V(0,1.2,0))
  solid(side+'_ClearOpticalLens','Optical_Lenses',lens,'glass','Protective optical lens; no prescription specified')
  # Eye tracking barrels face backwards into eye volume, outside clear aperture.
  camx=cx-s*21
  camera=cyl(side+'_IRCameraBarrel','Eye_Tracking_Assembly',(camx,Y+3,Z-14),3.1,7,'black',(0,1,0),'Inward NIR pupil and eyelid imaging','Pupil, gaze and blink screening; does not diagnose SANS');highlights.append(camera)
  cyl(side+'_IRCameraObjective','Eye_Tracking_Assembly',(camx,Y+10,Z-14),2.1,.8,'glass',(0,1,0))
  pcb(side+'_EyeCameraPCB','Eye_Tracking_Assembly',(camx-5,Y+1,Z-20),(10,9,.8),1)
  for i,(dx,dz) in enumerate([(-21,14),(21,14),(-23,-10),(23,-10)]):
   ring(side+'_IRRecess_'+str(i),'IR_Illumination_Assembly',(cx+dx,Y+1,Z+dz),1.8,1.1,2.5,'black',(0,1,0))
   o=cyl(side+'_IREmitter_'+str(i),'IR_Illumination_Assembly',(cx+dx,Y+1,Z+dz),.9,1.5,'cyan',(0,1,0),'Recessed infrared illumination package; radiant output unspecified','Requires eye-safety testing before use');highlights.append(o) if i==0 else None
  # Detachable hinges and temples; hollow electronics pod at ear stem.
  hx=X+s*69
  box(side+'_HingeLeaf','Hinges_And_Temples',(hx-3,Y-3,Z+10),(6,10,8),'metal')
  cyl(side+'_HingePin','Hinges_And_Temples',(hx,Y+2,Z+9),1.1,10)
  temple=box(side+'_TempleRail','Hinges_And_Temples',(hx-2,Y+7,Z+15),(4,13,5),'black')
  rear=box(side+'_RearTempleRail','Hinges_And_Temples',(hx-2,Y+82,Z+15),(4,46,5),'black');rear.setExpression('Width','Design_Parameters.TempleLength - 99 mm')
  cable(side+'_EarHook','Hinges_And_Temples',[(hx,Y+128,Z+17),(hx,Y+142,Z+13),(hx,Y+149,Z-3)],2.7)
  for i in range(3):box(side+'_TempleWireChannel_'+str(i),'Electronics',(hx-1,Y+15+i*30,Z+20),(2,27,.5),'gold','Exposed FPC trace segment in temple channel')
  rod(side+'_NosePadArm','Structural_Frame',(X+s*10,Y,Z-3),(X+s*7,Y+9,Z-8),1)
  cyl(side+'_NosePad','Structural_Frame',(X+s*7,Y+7,Z-10),3.3,2.5,'silicone',(0,1,0),'Adjustable silicone nose support')
 rod('BridgeArch','Structural_Frame',(X-6,Y-2,Z+9),(X+6,Y-2,Z+9),2.7,'black')
 box('BridgeCrossbar','Structural_Frame',(X-11,Y-4,Z+7),(22,4,5),'black')
 # Native serviceable temple pods, intentionally wider than fashion eyewear.
 for name,xx,g in [('ComputePod',X-75,'Electronics'),('BatteryPod',X+63,'Battery_And_Power')]:
  housing(name,g,(xx,Y+20,Z+10),(12,62,13),1.1)
 proc=pcb('Processor_PCB','Electronics',(X-73.5,Y+23,Z+11.5),(9,54,.8),5);highlights.append(proc)
 imu=box('SixAxis_IMU','IMU_Assembly',(X-70,Y+60,Z+13.7),(3,3,1),'black','3-axis acceleration and 3-axis angular rate','Head motion context for eye metric analysis');highlights.append(imu)
 box('TelemetryAntenna','Electronics',(X-72,Y+72,Z+13),(1,8,.3),'gold','Wireless antenna; RF matching not specified')
 batt=box('ProtectedBatteryCell','Battery_And_Power',(X+65,Y+23,Z+11.5),(8,37,8),'dark','Rechargeable cell package; capacity and thermal qualification TBD');highlights.append(batt)
 pcb('PowerManagement_PCB','Battery_And_Power',(X+64.5,Y+62,Z+12),(9,15,.7),2)
 ring('ChargingConnectorShell','Battery_And_Power',(X+69,Y+80,Z+15),2.4,1.6,3,'metal',(0,1,0))
 for i in range(4):cyl('ChargingContact_'+str(i),'Battery_And_Power',(X+67.5+i,Y+83,Z+15),.25,1,'gold',(0,1,0))
 for n,pt,fn in [('AmbientLightSensor',(X+56,Y-3,Z+24),'Ambient illuminance context'),('TemperatureSensor',(X-70,Y+16,Z+20.2),'Local device/environment temperature; not core temperature'),('HumiditySensor',(X+67.5,Y+85,Z+20.2),'Local relative humidity; not tear-film measurement')]:
  o=box(n,'Environmental_Sensors',pt,(3,3,1),'black',fn);highlights.append(o)
 md=box('NearEyeMicrodisplay','Visual_Test_Display',(X+52,Y+1,Z+14),(8,5,5),'dark','Microdisplay visual target source','Concept visual testing; luminance, focus and calibration unvalidated');highlights.append(md)
 box('MicrodisplayActiveFace','Visual_Test_Display',(X+52,Y+6,Z+14),(8,.4,5),'cyan')
 solid('OpticalCouplerPrism','Visual_Test_Display',Part.makeBox(9,7,6,V(X+42,Y+1,Z+11)),'glass','Concept folded near-eye optical coupler; optical prescription TBD')
 cable('BilateralFPC','Electronics',[(X-69,Y+25,Z+20),(X-69,Y+1,Z+23),(X,Y-1,Z+24),(X+69,Y+1,Z+23),(X+69,Y+25,Z+20)],.65,'gold')
 
 # B: mechanically separate table-supported modules, same rail interface.
 def dock(prefix,g,x,y,z):
  box(prefix+'_MountPlate',g,(x,y,z),(50,65,4),'metal')
  for s in [-1,1]:box(prefix+'_DovetailRail_'+str(s),g,(x+25+s*18-2,y+6,z+4),(4,52,5),'dark')
  for i in range(4):cyl(prefix+'_SpringContact_'+str(i),g,(x+19+i*4,y+55,z+4),.8,2,'gold')
  box(prefix+'_ReleaseLatch',g,(x+18,y+60,z+4),(14,7,4),'cyan')
 
 ox,oy,oz=-145,-95,25;g='OCT_Concept_Assembly'
 housing('OCT_ConceptHousing',g,(ox,oy,oz),(150,190,95),frontport=(102,50,18.4))
 box('OCT_OpticalBreadboard',g,(ox+7,oy+7,oz+5),(136,176,5),'metal','Optical engine datum plate')
 for i in range(12):screw('OCT_BreadboardFastener_'+str(i),g,(ox+12+(i%4)*38,oy+13+(i//4)*70,oz+3))
 pcb('OCT_ControlPCB',g,(ox+8,oy+145,oz+14),(78,34,1.6),8)
 box('OCT_LightSourcePackage',g,(ox+10,oy+15,oz+15),(35,35,20),'metal','Broadband source package concept','Source spectrum and power unspecified; no safe exposure claim')
 for i in range(7):box('OCT_SourceCoolingFin_'+str(i),g,(ox+10+i*5,oy+15,oz+35),(2,35,10),'metal')
 # Interferometer at horizontal optical bench height Z+50.
 H=oz+50
 solid('OCT_BeamSplitter',g,Part.makeBox(12,12,12,V(ox+64,oy+57,H-6)),'glass','Concept free-space interferometer splitter')
 box('OCT_SplitterMount',g,(ox+60,oy+53,oz+11),(20,20,30),'dark')
 ring('OCT_ReferenceCollimator',g,(ox+24,oy+63,H),7,4,12,'metal',(1,0,0))
 cyl('OCT_ReferenceMirror',g,(ox+14,oy+63,H),5,1,'metal',(1,0,0),'Reference arm mirror')
 rod('OCT_ReferenceTranslationRail',g,(ox+12,oy+55,oz+15),(ox+48,oy+55,oz+15),2)
 box('OCT_ReferenceStage',g,(ox+12,oy+53,oz+17),(14,20,8),'dark')
 for i in range(2):
  box('OCT_GalvoMotor_'+str(i),g,(ox+96,oy+70+i*25,H-11),(18,18,22),'dark','Scanning actuator package')
  cyl('OCT_ScanningMirror_'+str(i),g,(ox+91,oy+77+i*25,H),5,.8,'metal',(1,0,0),'Sample arm scanning mirror')
 ring('OCT_ObjectiveBarrel',g,(ox+102,oy-18,H),18,13,45,'metal',(0,1,0))
 for i in range(3):cyl('OCT_ObjectiveLens_'+str(i),g,(ox+102,oy-15+i*10,H),12,2,'glass',(0,1,0))
 ring('OCT_SiliconeEyeAlignment',g,(ox+102,oy-25,H),21,15,6,'silicone',(0,1,0),'Non-load-bearing eye alignment interface')
 rod('OCT_FocusLeadScrew',g,(ox+128,oy+2,H-20),(ox+128,oy+55,H-20),2)
 cyl('OCT_FocusThumbwheel',g,(ox+128,oy+58,H-20),8,4,'black',(0,1,0))
 solid('OCT_SpectrometerEnclosure',g,Part.makeBox(72,38,44,V(ox+10,oy+94,oz+14)).cut(Part.makeBox(68,34,43,V(ox+12,oy+96,oz+16))),'dark','Hollow spectral-domain detector subsystem enclosure')
 solid('OCT_DiffractionGrating',g,Part.makeBox(18,2,18,V(ox+36,oy+107,H-9)),'gold','Spectrometer diffraction grating concept')
 cyl('OCT_SpectrometerFocusLens',g,(ox+56,oy+113,H),7,2,'glass',(1,0,0))
 box('OCT_LineScanDetector',g,(ox+70,oy+106,H-6),(1,14,12),'pcb','Line-array detector package; pixel specification TBD')
 fix=cyl('OCT_FixationTarget',g,(ox+102,oy+39,H),2,2,'cyan',(0,1,0),'Fixation target; projection optical prescription TBD');highlights.append(fix)
 for i in range(8):box('OCT_RearVent_'+str(i),g,(ox+143,oy+110+i*7,oz+20),(1,4,12),'black','Vent location marker; cover machining TBD')
 cable('OCT_SourceFiber',g,[(ox+40,oy+30,H),(ox+50,oy+30,H),(ox+70,oy+63,H)],1,'gold')
 for n,a,b in [('ReferencePath',(ox+70,oy+63,H),(ox+20,oy+63,H)),('SamplePath',(ox+70,oy+63,H),(ox+102,oy+77,H)),('ObjectivePath',(ox+102,oy+77,H),(ox+102,oy-20,H)),('DetectorPath',(ox+70,oy+63,H),(ox+45,oy+113,H))]:rod('OCT_'+n,'Presentation_Optical_Paths',a,b,.65,'cyan','Illustrative optical path; no ray trace or performance model')
 dock('OCT_Dock','Docking_Connectors',ox+50,oy+65,oz-12)
 
 fx,fy,fz=35,-90,25;g='Fundus_Camera_Assembly'
 housing('Fundus_Housing',g,(fx,fy,fz),(100,155,85),frontport=(50,46,22.4))
 box('Fundus_OpticalBench',g,(fx+7,fy+8,fz+4),(86,138,5),'metal')
 H=fz+46
 ring('Fundus_ObjectiveBarrel',g,(fx+50,fy-22,H),22,17,62,'metal',(0,1,0))
 for i in range(3):cyl('Fundus_ObjectiveLens_'+str(i),g,(fx+50,fy-15+i*16,H),16,2,'glass',(0,1,0))
 ring('Fundus_EyeCup',g,(fx+50,fy-29,H),25,18,7,'silicone',(0,1,0))
 ring('Fundus_IlluminationAnnulus',g,(fx+50,fy+32,H),20,15,3,'gold',(0,1,0),'Annular retinal illumination optics')
 for i in range(8):
