 cyl('VisualStation_OcclusionShield',g,(sx-32,sy-506,sz+133),22,2,'black',(0,1,0),'Monocular occlusion shield')
 box('VisualStation_ControlPanel',g,(sx+170,sy-28,sz+13),(42,55,18),'white')
 for i in range(4):cyl('VisualStation_TestMode_'+str(i),g,(sx+180+(i%2)*20,sy-14+(i//2)*23,sz+32),5,2,'cyan','Acuity contrast Amsler exploratory visual field'.split()[i] if False else (0,0,1))
 # Independent articulated external covers are removed in exploded configuration.
 for o in parts:
  if o.Name.startswith('OCT_'):o.ExplodeOffset=V(-20,0,80 if o in covers else 18+(parts.index(o)%4)*18)
  elif o.Name.startswith('Fundus_'):o.ExplodeOffset=V(30,0,75 if o in covers else 15+(parts.index(o)%4)*14)
  elif o.Name.startswith('Tonometer_'):o.ExplodeOffset=V(0,0,40+(parts.index(o)%3)*14)
 
 # Named 3D identification anchors and leader arrows (hidden in normal config).
 ann=group('Sensor_Callouts',root)
 for i,o in enumerate(highlights,1):
  doc.recompute();bb=o.Shape.BoundBox;center=bb.Center
  anchor=doc.addObject('App::FeaturePython','Callout_%02d'%i);ann.addObject(anchor)
  anchor.addProperty('App::PropertyLink','Target','Annotation');anchor.Target=o
  anchor.addProperty('App::PropertyString','Text','Annotation');anchor.Text='%02d | %s | %s'%(i,o.Label,o.Function)
  endpoint=center+V(20,15,32)
  delta=center-endpoint
  shape=Part.makeCylinder(.5,delta.Length,endpoint,delta).fuse(Part.makeCone(2,0,5,center-delta.normalize()*5,delta))
  arrow=doc.addObject('Part::Feature','Leader_%02d'%i);arrow.Shape=shape;ann.addObject(arrow);arrow.ViewObject.ShapeColor=C['cyan'] if Gui else (0,1,1)
  arrow.addProperty('App::PropertyLink','Target','Annotation');arrow.Target=o;arrow.Visibility=False
 # Validate every registered component, retain failures and never silently accept null solids.
 doc.recompute()
 for o in parts:
  if o.Shape.isNull() or not o.Shape.isValid() or not o.Shape.Solids:errors.append(o.Name+': invalid / missing solid')
  for st in o.State:
   if st=='Invalid':errors.append(o.Name+': invalid recompute state')
 # Final assembled geometry must remain persistently visible (internals behind removable covers).
 for o in parts:o.Visibility=True
 for body in [o for o in parts if o.TypeId=='PartDesign::Body']:
  for f in body.Group:
   if f!=body.Tip:f.Visibility=False
  body.Tip.Visibility=True
 if Gui:
  Gui.activeDocument().activeView().viewIsometric();Gui.activeDocument().activeView().fitAll()
  Gui.activeDocument().activeView().setAnimationEnabled(False) if hasattr(Gui.activeDocument().activeView(),'setAnimationEnabled') else None
  Gui.updateGui()
 doc.saveAs(os.path.join(OUT,DOC+'.FCStd'))
 try:
  Part.export(parts,os.path.join(OUT,DOC+'.step'))
 except Exception as e:errors.append('STEP export: '+str(e))
 # Standalone tessellation allows an optional glTF exporter outside FreeCAD.
 meshes=[]
 for o in parts:
  vv,ff=o.Shape.tessellate(.65)
  meshes.append({'name':o.Name,'vertices':[[v.x,v.y,v.z] for v in vv],'faces':[list(f) for f in ff],'color':list(C.get('white')) if not Gui else list(o.ViewObject.ShapeColor),'transparent':o.Name.endswith('Lens') or (Gui and o.ViewObject.Transparency>0),'offset':list(o.ExplodeOffset),'cover':o in covers,'center':list(o.Shape.BoundBox.Center),'group':o.getParentGeoFeatureGroup().Name if o.getParentGeoFeatureGroup() else ''})
 with open(os.path.join(OUT,'geometry.json'),'w') as f:json.dump(meshes,f)
 with open(os.path.join(OUT,'VisionGuard_Components.csv'),'w',newline='') as f:
  w=csv.writer(f);w.writerow(['ID','CAD_Name','Component','Subsystem','HardwareClass','Function','ClinicalPurpose','ValidationStatus','SolidCount','Volume_mm3'])
  for i,o in enumerate(parts,1):
   parent=next((k for k,v in groups.items() if o in v.Group),'');w.writerow([i,o.Name,o.Label,parent,o.HardwareClass,o.Function,o.ClinicalPurpose,o.ValidationStatus,len(o.Shape.Solids),round(o.Shape.Volume,3)])
 with open(os.path.join(OUT,'validation.json'),'w') as f:json.dump({'components':len(parts),'solids':sum(len(o.Shape.Solids) for o in parts),'invalid':errors,'FreeCAD':App.Version(),'concept':True},f,indent=2)
 # GUI screenshots and standard engineering views. Additional macros provide configurations.
 if Gui:
  view=Gui.activeDocument().activeView()
  for name,method in [('Front','viewFront'),('Rear','viewRear'),('Left','viewLeft'),('Right','viewRight'),('Top','viewTop'),('Bottom','viewBottom')]:
   getattr(view,method)();view.fitAll();Gui.updateGui();view.saveImage(os.path.join(OUT,'VisionGuard_'+name+'.png'),1800,1200,'White')
  view.viewIsometric();view.fitAll();Gui.updateGui();view.saveImage(os.path.join(OUT,'VisionGuard_FullAssembly.png'),2000,1400,'White')
  for o in covers:o.ViewObject.Transparency=85
  Gui.updateGui();view.saveImage(os.path.join(OUT,'VisionGuard_TransparentInspection.png'),2000,1400,'White')
  for o in covers:o.ViewObject.Transparency=0
  # Explode whole parts by shape transform; works also for geometry with world-position coordinates.
  original={o.Name:o.Placement for o in parts}
  for o in parts:
   pl=o.Placement;pl.Base=pl.Base+o.ExplodeOffset;o.Placement=pl
  doc.recompute();view.fitAll();Gui.updateGui();view.saveImage(os.path.join(OUT,'VisionGuard_ExplodedView.png'),2000,1400,'White')
  for o in parts:o.Placement=original[o.Name]
  doc.recompute();view.viewIsometric();view.fitAll();Gui.updateGui();doc.save()
 if errors:App.Console.PrintError('\nVisionGuard errors: '+str(errors)+'\n')
 else:App.Console.PrintMessage('\nVisionGuard: %d solid components validated. Saved to %s\n'%(len(parts),OUT))
 if os.environ.get('VISIONGUARD_BATCH')=='1':
  from PySide import QtCore
  QtCore.QTimer.singleShot(1000,lambda: os._exit(0))
except Exception:
 report=traceback.format_exc()
 try:
  folder=globals().get("OUT",os.path.expanduser("~/VisionGuard"));os.makedirs(folder,exist_ok=True)
  with open(os.path.join(folder,"VisionGuard_GenerationError.txt"),"w") as errorfile:errorfile.write(report)
  App.Console.PrintError(report)
 except Exception:print(report)
 raise
