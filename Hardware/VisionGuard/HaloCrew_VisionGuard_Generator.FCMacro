  rod('VisualStation_AdjustablePost_'+str(i),g,(sx+i*110,sy+34,sz+12),(sx+i*110,sy+34,sz+240),7)
  ring('VisualStation_HeightCollar_'+str(i),g,(sx+i*110,sy+34,sz+135),11,7.4,18,'dark')
