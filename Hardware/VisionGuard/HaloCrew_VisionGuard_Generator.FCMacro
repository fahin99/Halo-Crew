  rod('VisualStation_AlignmentUpright_'+str(i),g,(sx+i*95,sy-500,sz+12),(sx+i*95,sy-500,sz+160),4)
 rod('VisualStation_ForeheadCrossbar',g,(sx-95,sy-500,sz+160),(sx+95,sy-500,sz+160),4)
 box('VisualStation_ForeheadPad',g,(sx-50,sy-505,sz+156),(100,6,10),'silicone')
